# Normalize line endings so Windows and macOS/Linux teammates don't fight over CRLF
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mp4  binary
*.pdf  binary
*.ttf  binary
*.otf  binary
